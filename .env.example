# ========================================================
# SMART CITY SOS — BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MySQL / MariaDB via Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/smart_city_sos"

# Authentication & JWT Secrets (Use strong random 32+ char strings in production)
JWT_SECRET="your_jwt_secret_key_change_in_production_min_32_chars"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_change_in_production_min_32_chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ISSUER="smart-city-sos"
JWT_AUDIENCE="smart-city-sos-users"

# CORS & Client Origins
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# File Uploads
UPLOAD_PATH="uploads"
MAX_FILE_SIZE=10485760

# Logging & Debugging
LOG_LEVEL="info"

# Email Verification & SMTP Settings (Optional in development)
REQUIRE_EMAIL_VERIFICATION="false"
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@smartcitysos.gov.kh"
SMTP_PASS="your-smtp-app-password"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
EMAIL_FROM="Smart City SOS <notifications@smartcitysos.gov.kh>"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"


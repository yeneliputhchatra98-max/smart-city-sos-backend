generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                      String                   @id @default(uuid())
  fullName                String
  badgeId                 String                   @default("N/A")
  username                String?                  @unique
  email                   String                   @unique
  password                String?
  phone                   String?
  status                  UserStatus               @default(ACTIVE)
  mfaEnabled              Boolean                  @default(false)
  failedLoginAttempts     Int                      @default(0)
  lastPasswordChange      DateTime                 @default(now())
  organizationId          String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  avatar                  String                   @default("account-avatar-profile-user.svg")
  roleId                  Int?
  googleId                String?                  @unique
  appleId                 String?                  @unique
  emailVerified           Boolean                  @default(false)
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  newsArticles            News[]                   @relation("NewsAuthor")
  refreshTokens           RefreshToken[]
  reportsCreated          ReportExport[]           @relation("ReportCreator")
  settingsUpdated         SystemSetting[]          @relation("SettingUpdater")
  organization            Organization?            @relation(fields: [organizationId], references: [id])
  role                    Role?                    @relation(fields: [roleId], references: [id])

  @@index([organizationId], map: "users_organizationId_fkey")
  @@index([roleId], map: "users_roleId_fkey")
  @@map("users")
}

model Organization {
  id                  String           @id @default(uuid())
  name                String
  type                OrganizationType
  hotline             String
  head                String
  address             String
  status              OrgStatus        @default(ACTIVE)
  accessLevel         AccessLevel      @default(STANDARD)
  gpsLat              Float?
  gpsLng              Float?
  activeVehiclesCount Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  agents              Agent[]
  officers            Officer[]
  stations            Station[]
  users               User[]

  @@map("organizations")
}

model Agent {
  id             String           @id @default(uuid())
  name           String
  role           String
  type           OrganizationType
  phone          String
  status         AgentStatus      @default(AVAILABLE)
  vehicleNo      String?
  vehicleType    String?
  organizationId String?
  lat            Float?
  lng            Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  sosAlerts      SOSAlert[]

  @@index([organizationId], map: "agents_organizationId_fkey")
  @@map("agents")
}

model Officer {
  id            String        @id @default(uuid())
  agencyId      String?
  nameKh        String
  nameEn        String
  title         String
  workPhone     String
  personalPhone String?
  photoUrl      String?
  languages     Json?
  status        OfficerStatus @default(ON_DUTY)
  shift         ShiftType     @default(DAY)
  assignedSos   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  agency        Organization? @relation(fields: [agencyId], references: [id])

  @@index([agencyId], map: "officers_agencyId_fkey")
  @@map("officers")
}

model Station {
  id             String           @id @default(uuid())
  name           String
  type           OrganizationType
  province       String
  district       String
  address        String
  hotline        String
  lat            Float?
  lng            Float?
  capacity       Int              @default(0)
  organizationId String?
  status         OrgStatus        @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization?    @relation(fields: [organizationId], references: [id])

  @@index([organizationId], map: "stations_organizationId_fkey")
  @@map("stations")
}

model SOSAlert {
  id                String        @id @default(uuid())
  citizenName       String
  phone             String
  type              EmergencyType
  district          String
  province          String        @default("Phnom Penh")
  lat               Float
  lng               Float
  reportText        String
  hasMedia          Boolean       @default(false)
  mediaUrls         Json?
  status            SOSStatus     @default(PENDING)
  assignedAgentId   String?
  assignedAgentName String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  resolvedAt        DateTime?
  assignedAgent     Agent?        @relation(fields: [assignedAgentId], references: [id])

  @@index([assignedAgentId], map: "sos_alerts_assignedAgentId_fkey")
  @@map("sos_alerts")
}

model CitizenReport {
  id          String        @id @default(uuid())
  citizenName String
  phone       String?
  type        EmergencyType
  title       String
  description String
  province    String
  district    String
  lat         Float?
  lng         Float?
  mediaUrls   Json?
  status      ReportStatus  @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("citizen_reports")
}

model Broadcast {
  id              String          @id @default(uuid())
  title           String
  message         String
  level           BroadcastLevel  @default(WARNING)
  type            BroadcastType   @default(SECURITY)
  targetAudience  AudienceType    @default(ALL_CITIZENS)
  status          BroadcastStatus @default(ACTIVE)
  targetProvinces Json?
  reachCount      Int             @default(0)
  expiresAt       DateTime?
  sentByUserId    String?
  sentByName      String?
  createdAt       DateTime        @default(now())

  @@map("broadcasts")
}

model News {
  id          String     @id @default(uuid())
  title       String
  slug        String     @unique
  summary     String?
  content     String
  coverUrl    String?
  category    String     @default("General")
  status      NewsStatus @default(PUBLISHED)
  authorId    String?
  publishedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  author      User?      @relation("NewsAuthor", fields: [authorId], references: [id])

  @@index([authorId], map: "news_authorId_fkey")
  @@map("news")
}

model SystemSetting {
  id              String   @id @default(uuid())
  key             String   @unique
  value           String
  description     String?
  isEncrypted     Boolean  @default(false)
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  updatedByUser   User?    @relation("SettingUpdater", fields: [updatedByUserId], references: [id])

  @@index([updatedByUserId], map: "system_settings_updatedByUserId_fkey")
  @@map("system_settings")
}

model RolePermission {
  id        String           @id @default(uuid())
  action    PermissionAction
  isGranted Boolean          @default(true)
  roleId    Int?
  role      Role?            @relation(fields: [roleId], references: [id])

  @@unique([roleId, action])
  @@map("role_permissions")
}

model ReportExport {
  id            String       @id @default(uuid())
  title         String
  reportType    ReportType   @default(SUMMARY)
  format        ReportFormat @default(PDF)
  fileUrl       String?
  fileSize      String?
  recordCount   Int          @default(0)
  resolvedCount Int          @default(0)
  delayedCount  Int          @default(0)
  createdById   String?
  createdAt     DateTime     @default(now())
  createdBy     User?        @relation("ReportCreator", fields: [createdById], references: [id])

  @@index([createdById], map: "report_exports_createdById_fkey")
  @@map("report_exports")
}

model AuditLog {
  id        String   @id @default(uuid())
  time      String
  event     String
  userId    String?
  userName  String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "audit_logs_userId_fkey")
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_userId_fkey")
  @@map("refresh_tokens")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING_VERIFICATION
}

enum OrganizationType {
  POLICE
  FIRE
  MEDICAL
}

enum EmergencyType {
  FIRE
  MEDICAL
  POLICE
  ACCIDENT
  CRIME
  FLOOD
  DISASTER
}

enum SOSStatus {
  PENDING
  EN_ROUTE
  RESOLVED
  SPAM
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

enum AgentStatus {
  AVAILABLE
  ON_DUTY
  OFFLINE
}

enum OrgStatus {
  ACTIVE
  INACTIVE
}

enum AccessLevel {
  HIGH
  MEDIUM
  STANDARD
}

enum BroadcastLevel {
  CRITICAL
  WARNING
  INFO
}

enum BroadcastType {
  FLOOD
  STORM
  FIRE
  TRAFFIC
  SECURITY
  MEDICAL_CRISIS
  GENERAL_ANNOUNCEMENT
}

enum BroadcastStatus {
  ACTIVE
  EXPIRED
}

enum AudienceType {
  ALL_CITIZENS
  RESCUE_AGENTS
}

enum OfficerStatus {
  ON_DUTY
  OFF_DUTY
  RESPONDING
}

enum ShiftType {
  DAY
  NIGHT
}

enum PermissionAction {
  VIEW_MAP
  DISPATCH
  BROADCAST
  MANAGE_USERS
  MANAGE_ORGS
  PUBLISH_NEWS
  EXPORT_REPORTS
  SYSTEM_SETTINGS
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReportType {
  SUMMARY
  DETAIL
  EXCEPTION
}

enum ReportFormat {
  PDF
  EXCEL
}
